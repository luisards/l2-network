FROM node:18-alpine

RUN apk add --no-cache git python3 make g++

WORKDIR /src
RUN git clone https://github.com/apache/age-viewer.git .

RUN npm config set engine-strict false
RUN npm run setup

# Must stay on the 7.x line: the backend's transpiled output requires
# @babel/runtime/regenerator, a subpath 8.x no longer exports.
RUN cd backend && npm install @babel/runtime@^7
RUN cd frontend && npm uninstall uuid && npm install uuid@8.3.2

ENV NODE_OPTIONS=--openssl-legacy-provider
ENV DISABLE_ESLINT_PLUGIN=true
RUN cd frontend && npm run build

EXPOSE 3001
CMD ["npm", "run", "deploy"]
